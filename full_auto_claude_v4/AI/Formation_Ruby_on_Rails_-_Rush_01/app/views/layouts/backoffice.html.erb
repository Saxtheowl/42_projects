<!DOCTYPE html>
<html>
  <head>
    <title>Backoffice - CRM Pro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_include_tag 'application' %>
  </head>

  <body>
    <nav class="navbar navbar-default navbar-fixed-top">
      <div class="container-fluid">
        <div class="navbar-header">
          <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar">
            <span class="sr-only">Toggle navigation</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
          </button>
          <%= link_to 'Manager Backoffice', backoffice_root_path, class: 'navbar-brand' %>
        </div>
        <div id="navbar" class="navbar-collapse collapse">
          <ul class="nav navbar-nav navbar-right">
            <li><%= link_to 'Back to Site', root_path %></li>
            <li><%= link_to 'Sign Out', destroy_user_session_path, method: :delete %></li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-3 col-md-2 sidebar">
          <%= link_to 'Dashboard', backoffice_root_path, class: request.path == backoffice_root_path ? 'active' : '' %>
          <%= link_to 'Users', backoffice_users_path, class: request.path.include?('/backoffice/users') ? 'active' : '' %>
          <%= link_to 'Clients', backoffice_clients_path, class: request.path.include?('/backoffice/clients') ? 'active' : '' %>
          <%= link_to 'Activity Logs', backoffice_activity_logs_path, class: request.path.include?('/backoffice/activity_logs') ? 'active' : '' %>
          <hr style="border-color: #444;">
          <strong style="color: #777; padding: 10px 20px; display: block;">Statistics</strong>
          <%= link_to 'Global', backoffice_statistics_global_path, class: request.path.include?('statistics/global') ? 'active' : '' %>
          <%= link_to 'By Client', backoffice_statistics_by_client_path, class: request.path.include?('statistics/by_client') ? 'active' : '' %>
          <%= link_to 'By Company', backoffice_statistics_by_company_path, class: request.path.include?('statistics/by_company') ? 'active' : '' %>
        </div>

        <div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main-content">
          <div class="flash-messages">
            <% flash.each do |type, message| %>
              <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <%= message %>
              </div>
            <% end %>
          </div>

          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
