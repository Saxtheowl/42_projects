<%= form_for [@project, @invoice], html: { class: 'form-horizontal' } do |f| %>
  <% if @invoice.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @invoice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :invoice_type, 'Type', class: 'col-sm-2 control-label' %>
    <div class="col-sm-10">
      <%= f.select :invoice_type, [['Outgoing (Client Invoice)', 'outgoing'], ['Incoming (Expense)', 'incoming']], {}, { class: 'form-control' } %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :intro, 'Introduction (Rich Text)', class: 'col-sm-2 control-label' %>
    <div class="col-sm-10">
      <%= f.text_area :intro, class: 'form-control', rows: 5 %>
    </div>
  </div>

  <h4>Line Items</h4>
  <div class="line-items-container">
    <%= f.fields_for :line_items do |item_form| %>
      <div class="line-item-row well">
        <div class="row">
          <div class="col-md-5">
            <%= item_form.text_field :description, class: 'form-control', placeholder: 'Description' %>
          </div>
          <div class="col-md-2">
            <%= item_form.number_field :price, class: 'form-control', placeholder: 'Price', step: 0.01 %>
          </div>
          <div class="col-md-2">
            <%= item_form.number_field :quantity, class: 'form-control', placeholder: 'Qty', value: item_form.object.quantity || 1 %>
          </div>
          <div class="col-md-3">
            <%= item_form.hidden_field :_destroy %>
            <button type="button" class="btn btn-danger remove-line-item">Remove</button>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <script type="text/html" class="line-item-template">
    <div class="line-item-row well">
      <div class="row">
        <div class="col-md-5">
          <input type="text" name="invoice[line_items_attributes][NEW_RECORD][description]" class="form-control" placeholder="Description">
        </div>
        <div class="col-md-2">
          <input type="number" name="invoice[line_items_attributes][NEW_RECORD][price]" class="form-control" placeholder="Price" step="0.01">
        </div>
        <div class="col-md-2">
          <input type="number" name="invoice[line_items_attributes][NEW_RECORD][quantity]" class="form-control" placeholder="Qty" value="1">
        </div>
        <div class="col-md-3">
          <input type="hidden" name="invoice[line_items_attributes][NEW_RECORD][_destroy]" value="0">
          <button type="button" class="btn btn-danger remove-line-item">Remove</button>
        </div>
      </div>
    </div>
  </script>

  <button type="button" class="btn btn-success add-line-item">Add Line Item</button>

  <hr>

  <div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
      <%= f.submit class: 'btn btn-primary' %>
      <%= link_to 'Cancel', @project, class: 'btn btn-default' %>
    </div>
  </div>
<% end %>
