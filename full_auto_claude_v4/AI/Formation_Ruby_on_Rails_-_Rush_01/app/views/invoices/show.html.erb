<div class="row">
  <div class="col-md-8">
    <h1>Invoice #<%= @invoice.id %> <span class="label label-<%= @invoice.outgoing? ? 'success' : 'warning' %>"><%= @invoice.invoice_type.capitalize %></span></h1>
  </div>
  <div class="col-md-4 text-right">
    <%= link_to 'PDF', pdf_project_invoice_path(@project, @invoice), class: 'btn btn-default' %>
    <%= link_to 'Edit', edit_project_invoice_path(@project, @invoice), class: 'btn btn-default' %>
    <%= link_to 'Back', @project, class: 'btn btn-default' %>
  </div>
</div>

<div class="card">
  <div class="row">
    <div class="col-md-6">
      <h4>Client Information</h4>
      <p><strong>Client:</strong> <%= @invoice.client.full_name %></p>
      <p><strong>Company:</strong> <%= @invoice.client.company&.name %></p>
      <p><strong>Operator:</strong> <%= @invoice.user.full_name %></p>
    </div>
    <div class="col-md-6 text-right">
      <p><strong>Created:</strong> <%= @invoice.created_at.strftime('%Y-%m-%d') %></p>
      <p><strong>Project:</strong> <%= @project.name %></p>
      <p><strong>Type:</strong> <%= @invoice.outgoing? ? 'Client Invoice (Revenue)' : 'Expense Invoice (Cost)' %></p>
    </div>
  </div>

  <% if @invoice.intro.present? %>
    <hr>
    <h4>Introduction</h4>
    <div class="well">
      <%= @invoice.intro.html_safe %>
    </div>
  <% end %>

  <hr>
  <h4>Line Items</h4>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Description</th>
        <th class="text-right">Price</th>
        <th class="text-right">Quantity</th>
        <th class="text-right">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% @invoice.line_items.each do |item| %>
        <tr>
          <td><%= item.description %></td>
          <td class="text-right"><%= number_to_currency(item.price, unit: '') %> EUR</td>
          <td class="text-right"><%= item.quantity %></td>
          <td class="text-right"><%= number_to_currency(item.subtotal, unit: '') %> EUR</td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="3" class="text-right">Total:</th>
        <th class="text-right"><%= number_to_currency(@invoice.total || @invoice.calculate_total, unit: '') %> EUR</th>
      </tr>
    </tfoot>
  </table>
</div>
