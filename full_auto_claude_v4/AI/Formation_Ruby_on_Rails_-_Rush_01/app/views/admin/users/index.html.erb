<div class="row">
  <div class="col-md-8">
    <h1>Users</h1>
  </div>
  <div class="col-md-4 text-right">
    <%= link_to 'New User', new_admin_user_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="card">
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Group</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.full_name %></td>
          <td><%= user.email %></td>
          <td><span class="label label-<%= user.admin? ? 'danger' : (user.manager? ? 'warning' : 'default') %>"><%= user.role&.capitalize %></span></td>
          <td><%= user.operator_group %></td>
          <td class="table-actions">
            <%= link_to 'View', admin_user_path(user), class: 'btn btn-xs btn-primary' %>
            <%= link_to 'Edit', edit_admin_user_path(user), class: 'btn btn-xs btn-default' %>
            <%= link_to 'Delete', admin_user_path(user), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-xs btn-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
