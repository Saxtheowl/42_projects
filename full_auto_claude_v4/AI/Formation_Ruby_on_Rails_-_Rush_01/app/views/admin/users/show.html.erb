<h1><%= @user.full_name %></h1>

<div class="card">
  <table class="table">
    <tr>
      <th>Email</th>
      <td><%= @user.email %></td>
    </tr>
    <tr>
      <th>Role</th>
      <td><span class="label label-<%= @user.admin? ? 'danger' : (@user.manager? ? 'warning' : 'default') %>"><%= @user.role&.capitalize %></span></td>
    </tr>
    <tr>
      <th>Group</th>
      <td><%= @user.operator_group || 'None' %></td>
    </tr>
    <tr>
      <th>Created</th>
      <td><%= @user.created_at.strftime('%Y-%m-%d') %></td>
    </tr>
  </table>

  <div class="text-right">
    <%= link_to 'Edit', edit_admin_user_path(@user), class: 'btn btn-default' %>
    <%= link_to 'Delete', admin_user_path(@user), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
    <%= link_to 'Back', admin_users_path, class: 'btn btn-default' %>
  </div>
</div>
