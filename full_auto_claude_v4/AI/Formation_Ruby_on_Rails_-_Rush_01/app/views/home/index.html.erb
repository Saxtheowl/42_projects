<div class="hero-section">
  <div class="container">
    <h1>Welcome to CRM Pro</h1>
    <p>The complete business management solution for modern enterprises</p>
    <% unless user_signed_in? %>
      <%= link_to 'Get Started', new_user_registration_path, class: 'btn btn-lg btn-primary' %>
      <%= link_to 'Sign In', new_user_session_path, class: 'btn btn-lg btn-default' %>
    <% else %>
      <%= link_to 'Go to Dashboard', clients_path, class: 'btn btn-lg btn-primary' %>
    <% end %>
  </div>
</div>

<div class="container">
  <div class="row">
    <div class="col-md-4">
      <div class="feature-box">
        <i class="glyphicon glyphicon-user" style="font-size: 48px; color: #337ab7;"></i>
        <h3>Client Management</h3>
        <p>Organize and track all your clients and companies in one place. Import data easily via CSV.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="feature-box">
        <i class="glyphicon glyphicon-briefcase" style="font-size: 48px; color: #337ab7;"></i>
        <h3>Project Suite</h3>
        <p>Manage projects with quotes, orders, and invoices. Generate professional PDFs instantly.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="feature-box">
        <i class="glyphicon glyphicon-envelope" style="font-size: 48px; color: #337ab7;"></i>
        <h3>Internal Messaging</h3>
        <p>Communicate with your team through our built-in messaging system. Track all communications.</p>
      </div>
    </div>
  </div>

  <hr>

  <div class="row">
    <div class="col-md-6">
      <h2>About Our Company</h2>
      <p>CRM Pro is a fictional company created for demonstration purposes. We specialize in providing innovative business solutions that help organizations streamline their operations and improve productivity.</p>
      <p>Our platform integrates client management, project tracking, invoicing, and internal communication into a single, easy-to-use system.</p>
      <%= image_tag 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=600', class: 'img-responsive img-rounded', alt: 'Office' %>
    </div>
    <div class="col-md-6">
      <h2>Watch Our Demo</h2>
      <div class="video-container">
        <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" frameborder="0" allowfullscreen></iframe>
      </div>
      <h3>Our Services</h3>
      <ul>
        <li>Client Database Management</li>
        <li>Project & Invoice Tracking</li>
        <li>Survey Creation & Analytics</li>
        <li>Team Communication Tools</li>
        <li>Real-time Reporting & Charts</li>
      </ul>
    </div>
  </div>

  <hr>

  <div class="row">
    <div class="col-md-12 text-center">
      <h2>Our Team</h2>
    </div>
  </div>
  <div class="row">
    <div class="col-md-3">
      <div class="card text-center">
        <%= image_tag 'https://i.pravatar.cc/150?img=1', class: 'img-circle', width: '100' %>
        <h4>John Smith</h4>
        <p>CEO</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <%= image_tag 'https://i.pravatar.cc/150?img=2', class: 'img-circle', width: '100' %>
        <h4>Jane Doe</h4>
        <p>CTO</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <%= image_tag 'https://i.pravatar.cc/150?img=3', class: 'img-circle', width: '100' %>
        <h4>Mike Johnson</h4>
        <p>Lead Developer</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <%= image_tag 'https://i.pravatar.cc/150?img=4', class: 'img-circle', width: '100' %>
        <h4>Sarah Wilson</h4>
        <p>Sales Director</p>
      </div>
    </div>
  </div>
</div>
