<div class="container">
  <div class="row">
    <div class="col-md-8 col-md-offset-2">
      <div class="card text-center">
        <h1>Thank You!</h1>

        <% if @survey.thank_you.present? %>
          <div class="well">
            <%= @survey.thank_you.html_safe %>
          </div>
        <% else %>
          <p class="lead">Thank you for completing our survey. Your response has been recorded.</p>
        <% end %>

        <%= link_to 'Back to Home', root_path, class: 'btn btn-primary' %>
      </div>
    </div>
  </div>
</div>
