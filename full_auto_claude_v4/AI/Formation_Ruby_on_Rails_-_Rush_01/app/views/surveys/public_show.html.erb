<div class="container">
  <div class="row">
    <div class="col-md-8 col-md-offset-2">
      <div class="card">
        <h1><%= @survey.title %></h1>

        <% if @survey.intro.present? %>
          <div class="well">
            <%= @survey.intro.html_safe %>
          </div>
        <% end %>

        <%= form_for @response, url: respond_survey_path(@survey), html: { class: 'form-horizontal' } do |f| %>
          <% if @response.errors.any? %>
            <div class="alert alert-danger">
              <ul>
                <% @response.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="form-group">
            <%= f.label :email, class: 'col-sm-2 control-label' %>
            <div class="col-sm-10">
              <%= f.email_field :email, class: 'form-control', placeholder: 'Your email address' %>
            </div>
          </div>

          <hr>

          <h3>Questions</h3>
          <% @survey.survey_questions.each_with_index do |question, index| %>
            <div class="form-group">
              <label class="col-sm-8 control-label text-left"><%= question.question %></label>
              <div class="col-sm-4">
                <label class="radio-inline">
                  <input type="radio" name="survey_response[survey_answers_attributes][<%= index %>][answer]" value="true"> Yes
                </label>
                <label class="radio-inline">
                  <input type="radio" name="survey_response[survey_answers_attributes][<%= index %>][answer]" value="false"> No
                </label>
                <input type="hidden" name="survey_response[survey_answers_attributes][<%= index %>][survey_question_id]" value="<%= question.id %>">
              </div>
            </div>
          <% end %>

          <hr>

          <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
              <%= f.submit 'Submit Response', class: 'btn btn-primary btn-lg' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
