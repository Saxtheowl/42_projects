<div class="card">
  <div class="row">
    <div class="col-md-6">
      <p><strong>From:</strong> <%= @in_mail.sender.full_name %></p>
      <p><strong>To:</strong> <%= @in_mail.recipient&.full_name %></p>
    </div>
    <div class="col-md-6 text-right">
      <p><strong>Date:</strong> <%= @in_mail.created_at.strftime('%Y-%m-%d %H:%M') %></p>
      <%= link_to 'Download PDF', pdf_in_mail_path(@in_mail), class: 'btn btn-default' %>
    </div>
  </div>

  <hr>

  <h3><%= @in_mail.subject %></h3>

  <div class="well">
    <%= simple_format(@in_mail.body) %>
  </div>

  <div class="text-right">
    <%= link_to 'Reply', new_in_mail_path(recipient_id: @in_mail.sender_id), class: 'btn btn-primary' %>
    <%= link_to 'Back to Inbox', inbox_in_mails_path, class: 'btn btn-default' %>
  </div>
</div>
