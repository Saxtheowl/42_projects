<div class="row">
  <div class="col-md-8">
    <h1><%= @client.full_name %></h1>
  </div>
  <div class="col-md-4 text-right">
    <%= link_to 'Edit', edit_client_path(@client), class: 'btn btn-default' %>
    <%= link_to 'Back', clients_path, class: 'btn btn-default' %>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card">
      <h3>Contact Information</h3>
      <table class="table">
        <tr>
          <th>Email</th>
          <td><%= @client.email %></td>
        </tr>
        <tr>
          <th>Phone</th>
          <td><%= @client.phone %></td>
        </tr>
        <tr>
          <th>Company</th>
          <td><%= @client.company&.name %></td>
        </tr>
        <tr>
          <th>Position</th>
          <td><%= @client.position %></td>
        </tr>
        <tr>
          <th>Assigned To</th>
          <td><%= @client.user&.full_name %></td>
        </tr>
      </table>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <h3>Projects (<%= @projects.count %>)</h3>
      <% if @projects.any? %>
        <ul class="list-group">
          <% @projects.each do |project| %>
            <li class="list-group-item">
              <%= link_to project.name, project %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted">No projects for this client.</p>
      <% end %>
    </div>
  </div>
</div>

<div class="card">
  <h3>Activity History</h3>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Date</th>
        <th>Action</th>
        <th>User</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% @activity_logs.each do |log| %>
        <tr>
          <td><%= log.formatted_date %></td>
          <td><%= log.action.humanize %></td>
          <td><%= log.user&.full_name %></td>
          <td><%= log.details %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @activity_logs.empty? %>
    <p class="text-muted">No activity recorded.</p>
  <% end %>
</div>
