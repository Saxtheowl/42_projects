<h1>Assign Group to <%= @user.full_name %></h1>

<div class="card">
  <%= form_for [:backoffice, @user], html: { class: 'form-horizontal' } do |f| %>
    <div class="form-group">
      <%= f.label :operator_group, 'Group', class: 'col-sm-2 control-label' %>
      <div class="col-sm-10">
        <%= f.select :operator_group, User::OPERATOR_GROUPS, { include_blank: 'None' }, { class: 'form-control' } %>
      </div>
    </div>

    <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
        <%= f.submit 'Update Group', class: 'btn btn-primary' %>
        <%= link_to 'Cancel', backoffice_users_path, class: 'btn btn-default' %>
      </div>
    </div>
  <% end %>
</div>
