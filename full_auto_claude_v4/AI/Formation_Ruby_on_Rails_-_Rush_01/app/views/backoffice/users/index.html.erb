<h1>User Management</h1>

<div class="card">
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Group</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.full_name %></td>
          <td><%= user.email %></td>
          <td><span class="label label-<%= user.admin? ? 'danger' : (user.manager? ? 'warning' : 'default') %>"><%= user.role&.capitalize %></span></td>
          <td><%= user.operator_group || 'None' %></td>
          <td class="table-actions">
            <%= link_to 'View', backoffice_user_path(user), class: 'btn btn-xs btn-primary' %>
            <% if user.operator? %>
              <%= link_to 'Assign Group', edit_backoffice_user_path(user), class: 'btn btn-xs btn-default' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
