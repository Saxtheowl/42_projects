<div class="container mt-4">
  <h1 class="text-center mb-4">Ruby on Rails CheatSheet</h1>

  <!-- Convention Section -->
  <section id="convention" class="mb-5">
    <h2>Convention</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Convention</th>
          <th>Example</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Class names</td><td>CamelCase</td></tr>
        <tr><td>Methods and variables</td><td>snake_case</td></tr>
        <tr><td>Database tables</td><td>plural_snake_case</td></tr>
        <tr><td>Model files</td><td>singular_snake_case.rb</td></tr>
        <tr><td>Controller files</td><td>plural_snake_case_controller.rb</td></tr>
        <tr><td>View folders</td><td>plural_snake_case/</td></tr>
        <tr><td>Constants</td><td>SCREAMING_SNAKE_CASE</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Console Section -->
  <section id="console" class="mb-5">
    <h2>Console</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Command</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>rails console</td><td>Start Rails console</td></tr>
        <tr><td>rails c</td><td>Shortcut for rails console</td></tr>
        <tr><td>reload!</td><td>Reload console environment</td></tr>
        <tr><td>exit</td><td>Exit the console</td></tr>
        <tr><td>app.get "/path"</td><td>Make GET request in console</td></tr>
        <tr><td>helper.method_name</td><td>Call helper methods</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Ruby Section -->
  <section id="ruby" class="mb-5">
    <h2>Ruby Basics</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Syntax</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>puts "text"</td><td>Print with newline</td></tr>
        <tr><td>print "text"</td><td>Print without newline</td></tr>
        <tr><td>gets.chomp</td><td>Get user input</td></tr>
        <tr><td>#comment</td><td>Single line comment</td></tr>
        <tr><td>=begin =end</td><td>Multi-line comment</td></tr>
        <tr><td>variable = value</td><td>Variable assignment</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Ruby Concepts Section -->
  <section id="ruby-concepts" class="mb-5">
    <h2>Ruby Concepts</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Concept</th>
          <th>Example</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Class definition</td><td>class MyClass; end</td></tr>
        <tr><td>Instance method</td><td>def method_name; end</td></tr>
        <tr><td>Class method</td><td>def self.method_name; end</td></tr>
        <tr><td>Inheritance</td><td>class Child < Parent; end</td></tr>
        <tr><td>Module</td><td>module MyModule; end</td></tr>
        <tr><td>Include module</td><td>include MyModule</td></tr>
        <tr><td>Extend module</td><td>extend MyModule</td></tr>
        <tr><td>Attr accessor</td><td>attr_accessor :name</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Ruby Numbers Section -->
  <section id="ruby-numbers" class="mb-5">
    <h2>Ruby Numbers</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Operation</th>
          <th>Example</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Addition</td><td>5 + 3 => 8</td></tr>
        <tr><td>Subtraction</td><td>5 - 3 => 2</td></tr>
        <tr><td>Multiplication</td><td>5 * 3 => 15</td></tr>
        <tr><td>Division</td><td>5 / 3 => 1</td></tr>
        <tr><td>Float division</td><td>5.0 / 3 => 1.666...</td></tr>
        <tr><td>Modulo</td><td>5 % 3 => 2</td></tr>
        <tr><td>Exponent</td><td>5 ** 3 => 125</td></tr>
        <tr><td>Absolute</td><td>-5.abs => 5</td></tr>
        <tr><td>Round</td><td>3.7.round => 4</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Ruby Strings Section -->
  <section id="ruby-strings" class="mb-5">
    <h2>Ruby Strings</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Method</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>.length</td><td>Return string length</td></tr>
        <tr><td>.reverse</td><td>Reverse the string</td></tr>
        <tr><td>.upcase</td><td>Convert to uppercase</td></tr>
        <tr><td>.downcase</td><td>Convert to lowercase</td></tr>
        <tr><td>.capitalize</td><td>Capitalize first letter</td></tr>
        <tr><td>.include?("x")</td><td>Check if contains "x"</td></tr>
        <tr><td>.gsub("a","b")</td><td>Replace "a" with "b"</td></tr>
        <tr><td>.split(" ")</td><td>Split into array</td></tr>
        <tr><td>.strip</td><td>Remove whitespace</td></tr>
        <tr><td>"#{var}"</td><td>String interpolation</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Ruby Arrays Section -->
  <section id="ruby-arrays" class="mb-5">
    <h2>Ruby Arrays</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Method</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>arr = []</td><td>Create empty array</td></tr>
        <tr><td>arr[0]</td><td>Access first element</td></tr>
        <tr><td>arr[-1]</td><td>Access last element</td></tr>
        <tr><td>arr.push(x)</td><td>Add element to end</td></tr>
        <tr><td>arr << x</td><td>Shovel operator (add)</td></tr>
        <tr><td>arr.pop</td><td>Remove last element</td></tr>
        <tr><td>arr.shift</td><td>Remove first element</td></tr>
        <tr><td>arr.unshift(x)</td><td>Add to beginning</td></tr>
        <tr><td>arr.each { |x| }</td><td>Iterate over elements</td></tr>
        <tr><td>arr.map { |x| }</td><td>Transform elements</td></tr>
        <tr><td>arr.select { |x| }</td><td>Filter elements</td></tr>
        <tr><td>arr.sort</td><td>Sort array</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Ruby Hashes Section -->
  <section id="ruby-hashes" class="mb-5">
    <h2>Ruby Hashes</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Syntax</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>hash = {}</td><td>Create empty hash</td></tr>
        <tr><td>hash = { key: value }</td><td>Symbol key syntax</td></tr>
        <tr><td>hash["key"]</td><td>Access by key</td></tr>
        <tr><td>hash[:key]</td><td>Access by symbol</td></tr>
        <tr><td>hash.keys</td><td>Get all keys</td></tr>
        <tr><td>hash.values</td><td>Get all values</td></tr>
        <tr><td>hash.each { |k,v| }</td><td>Iterate over pairs</td></tr>
        <tr><td>hash.merge(other)</td><td>Merge two hashes</td></tr>
        <tr><td>hash.delete(:key)</td><td>Delete a key</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Rails Folder Structure Section -->
  <section id="rails-folder-structure" class="mb-5">
    <h2>Rails Folder Structure</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Folder/File</th>
          <th>Purpose</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>app/</td><td>Main application code</td></tr>
        <tr><td>app/controllers/</td><td>Controller classes</td></tr>
        <tr><td>app/models/</td><td>Model classes</td></tr>
        <tr><td>app/views/</td><td>View templates</td></tr>
        <tr><td>app/helpers/</td><td>View helpers</td></tr>
        <tr><td>app/assets/</td><td>CSS, JS, images</td></tr>
        <tr><td>config/</td><td>Configuration files</td></tr>
        <tr><td>config/routes.rb</td><td>URL routing</td></tr>
        <tr><td>db/</td><td>Database files</td></tr>
        <tr><td>db/migrate/</td><td>Database migrations</td></tr>
        <tr><td>public/</td><td>Static files</td></tr>
        <tr><td>Gemfile</td><td>Ruby dependencies</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Rails Commands Section -->
  <section id="rails-commands" class="mb-5">
    <h2>Rails Commands</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Command</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>rails new app_name</td><td>Create new Rails app</td></tr>
        <tr><td>rails server / rails s</td><td>Start development server</td></tr>
        <tr><td>rails generate / rails g</td><td>Generate code</td></tr>
        <tr><td>rails g controller Name</td><td>Generate controller</td></tr>
        <tr><td>rails g model Name</td><td>Generate model</td></tr>
        <tr><td>rails g migration Name</td><td>Generate migration</td></tr>
        <tr><td>rails db:migrate</td><td>Run migrations</td></tr>
        <tr><td>rails db:rollback</td><td>Rollback last migration</td></tr>
        <tr><td>rails db:seed</td><td>Run seed file</td></tr>
        <tr><td>rails routes</td><td>Show all routes</td></tr>
        <tr><td>bundle install</td><td>Install gems</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Rails ERB Section -->
  <section id="rails-erb" class="mb-5">
    <h2>Rails ERB</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Syntax</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>&lt;%= %&gt;</td><td>Execute and output result</td></tr>
        <tr><td>&lt;% %&gt;</td><td>Execute without output</td></tr>
        <tr><td>&lt;%# %&gt;</td><td>ERB comment</td></tr>
        <tr><td>&lt;%= link_to "text", path %&gt;</td><td>Create link</td></tr>
        <tr><td>&lt;%= image_tag "file.png" %&gt;</td><td>Display image</td></tr>
        <tr><td>&lt;%= render "partial" %&gt;</td><td>Render partial</td></tr>
        <tr><td>&lt;%= form_with %&gt;</td><td>Create form</td></tr>
        <tr><td>&lt;%= yield %&gt;</td><td>Insert view content</td></tr>
        <tr><td>&lt;%= content_for :name %&gt;</td><td>Named content block</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Editor Section -->
  <section id="editor" class="mb-5">
    <h2>Editor Tips</h2>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Tool</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
