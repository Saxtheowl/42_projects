        <tr><td>RubyMine</td><td>Full-featured Ruby IDE</td></tr>
        <tr><td>Sublime Text</td><td>Lightweight editor</td></tr>
        <tr><td>Vim/Neovim</td><td>Terminal-based editor</td></tr>
        <tr><td>rubocop</td><td>Ruby style checker</td></tr>
        <tr><td>solargraph</td><td>Ruby language server</td></tr>
      </tbody>
    </table>
  </section>

