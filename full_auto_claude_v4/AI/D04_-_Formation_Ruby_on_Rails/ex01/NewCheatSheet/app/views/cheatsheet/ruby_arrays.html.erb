<div class="container mt-4">
  <h1>Ruby Arrays</h1>
  <table class="table table-bordered table-striped">
    <thead class="table-dark">
      <tr>
        <th>Method</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>arr = []</td><td>Create empty array</td></tr>
      <tr><td>arr[0]</td><td>Access first element</td></tr>
      <tr><td>arr[-1]</td><td>Access last element</td></tr>
      <tr><td>arr.push(x)</td><td>Add element to end</td></tr>
      <tr><td>arr << x</td><td>Shovel operator (add)</td></tr>
      <tr><td>arr.pop</td><td>Remove last element</td></tr>
      <tr><td>arr.shift</td><td>Remove first element</td></tr>
      <tr><td>arr.unshift(x)</td><td>Add to beginning</td></tr>
      <tr><td>arr.each { |x| }</td><td>Iterate over elements</td></tr>
      <tr><td>arr.map { |x| }</td><td>Transform elements</td></tr>
      <tr><td>arr.select { |x| }</td><td>Filter elements</td></tr>
      <tr><td>arr.sort</td><td>Sort array</td></tr>
    </tbody>
  </table>
</div>
