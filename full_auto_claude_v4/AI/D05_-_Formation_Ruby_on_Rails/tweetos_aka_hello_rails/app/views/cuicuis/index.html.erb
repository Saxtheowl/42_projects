<h1>Cuicuis</h1>

<table>
  <thead>
    <tr>
      <th>Content</th>
      <th>User</th>
      <th>Likes</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @cuicuis.each do |cuicui| %>
      <tr>
        <td><%= cuicui.content %></td>
        <td><%= cuicui.user_id %></td>
        <td><%= cuicui.likes.count %></td>
        <td><%= link_to 'Show', cuicui %></td>
        <td><%= link_to 'Edit', edit_cuicui_path(cuicui) %></td>
        <td><%= link_to 'Destroy', cuicui, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Cuicui', new_cuicui_path %> |
<%= link_to 'Users', users_path %> |
<%= link_to 'Top Cuicuis', top_cuicuis_path %>
