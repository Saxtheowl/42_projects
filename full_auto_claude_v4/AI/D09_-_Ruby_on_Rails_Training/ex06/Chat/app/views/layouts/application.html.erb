<!DOCTYPE html>
<html>
  <head>
    <title>Chat</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <% if user_signed_in? %>
      <meta name="current-user-id" content="<%= current_user.id %>">
    <% end %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <audio id="notification_sound" preload="auto">
      <source src="/notification.mp3" type="audio/mpeg">
    </audio>

    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <% if user_signed_in? %>
      <p>Logged in as: <%= current_user.email %> | <%= link_to 'Logout', destroy_user_session_path, method: :delete %></p>

      <div id="notifications">
        <h3>Notifications (<span id="notifications_count">0</span>)</h3>
        <ul id="notifications_list"></ul>
      </div>
    <% else %>
      <p><%= link_to 'Login', new_user_session_path %> | <%= link_to 'Sign Up', new_user_registration_path %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
