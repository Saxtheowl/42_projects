<h1>New Chatroom</h1>

<%= form_with model: @chatroom do |form| %>
  <% if @chatroom.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% @chatroom.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>

<%= link_to 'Back', chatrooms_path %>
