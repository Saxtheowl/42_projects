<div class="container mt-4">
  <h1>Rails Folder Structure</h1>
  <table class="table table-bordered table-striped">
    <thead class="table-dark">
      <tr>
        <th>Folder/File</th>
        <th>Purpose</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>app/</td><td>Main application code</td></tr>
      <tr><td>app/controllers/</td><td>Controller classes</td></tr>
      <tr><td>app/models/</td><td>Model classes</td></tr>
      <tr><td>app/views/</td><td>View templates</td></tr>
      <tr><td>app/helpers/</td><td>View helpers</td></tr>
      <tr><td>app/assets/</td><td>CSS, JS, images</td></tr>
      <tr><td>config/</td><td>Configuration files</td></tr>
      <tr><td>config/routes.rb</td><td>URL routing</td></tr>
      <tr><td>db/</td><td>Database files</td></tr>
      <tr><td>db/migrate/</td><td>Database migrations</td></tr>
      <tr><td>public/</td><td>Static files</td></tr>
      <tr><td>Gemfile</td><td>Ruby dependencies</td></tr>
    </tbody>
  </table>
</div>
