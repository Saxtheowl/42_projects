<h1>My Orders</h1>

<% if @orders.empty? %>
  <p>You have no orders yet.</p>
  <%= link_to 'Start Shopping', products_path, class: 'btn' %>
<% else %>
  <table class="orders-table">
    <thead>
      <tr>
        <th>Order #</th>
        <th>Date</th>
        <th>Status</th>
        <th>Total</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= order.id %></td>
          <td><%= order.created_at.strftime('%Y-%m-%d %H:%M') %></td>
          <td><span class="status-<%= order.status %>"><%= order.status.capitalize %></span></td>
          <td><%= number_to_currency(order.total) %></td>
          <td><%= link_to 'View', order, class: 'btn btn-sm' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @orders %>
<% end %>
