<h1>Order #<%= @order.id %></h1>

<div class="order-details">
  <div class="order-info">
    <p><strong>Date:</strong> <%= @order.created_at.strftime('%Y-%m-%d %H:%M') %></p>
    <p><strong>Status:</strong> <span class="status-<%= @order.status %>"><%= @order.status.capitalize %></span></p>
  </div>

  <h2>Order Items</h2>
  <table class="order-items-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_items.includes(:product).each do |item| %>
        <tr>
          <td><%= link_to item.product.name, item.product %></td>
          <td><%= number_to_currency(item.unit_price) %></td>
          <td><%= item.quantity %></td>
          <td><%= number_to_currency(item.total_price) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3"><strong>Total</strong></td>
        <td><strong><%= number_to_currency(@order.total) %></strong></td>
      </tr>
    </tfoot>
  </table>

  <%= link_to 'Back to Orders', orders_path, class: 'btn' %>
</div>
