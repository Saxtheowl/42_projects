<%= form_for(@brand) do |f| %>
  <% if @brand.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@brand.errors.count, "error") %> prohibited this brand from being saved:</h2>
      <ul>
        <% @brand.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :avatar, 'Brand Image' %>
    <%= f.file_field :avatar %>
    <% if @brand.avatar.present? %>
      <div class="current-image">
        <p>Current image:</p>
        <%= image_tag @brand.avatar.thumb.url %>
      </div>
    <% end %>
  </div>

  <div class="actions">
    <%= f.submit class: 'btn' %>
    <%= link_to 'Cancel', brands_path, class: 'btn' %>
  </div>
<% end %>
