<%= form_with model: like do |form| %>
  <% if like.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(like.errors.count, "error") %> prohibited this like from being saved:</h2>
      <ul>
        <% like.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id %>
    <%= form.number_field :user_id %>
  </div>

  <div>
    <%= form.label :cuicui_id %>
    <%= form.number_field :cuicui_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
